DJANGO_SECRET_KEY=change-me-to-anything-random
DEBUG=True

# Local Postgres (if not using Supabase)
DB_NAME=hackathon_db
DB_USER=postgres
DB_PASSWORD=postgres
DB_HOST=localhost
DB_PORT=5432

# If using Supabase instead: copy the connection string pieces from
