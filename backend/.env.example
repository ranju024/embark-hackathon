# ---- Django ----
DJANGO_SECRET_KEY=change-me
DEBUG=True
# Production only: comma-separated hosts (Render's own hostname is added automatically)
ALLOWED_HOSTS=

# ---- Database (local Postgres by default) ----
DB_NAME=db_name
DB_USER=postgres
DB_PASSWORD=postgres
DB_HOST=localhost
DB_PORT=5432
# Supabase only: set to require
DB_SSLMODE=

# ---- Uploaded files: Supabase Storage (leave blank locally, files go to backend/media/) ----
SUPABASE_S3_ENDPOINT=
SUPABASE_S3_REGION=
SUPABASE_S3_ACCESS_KEY_ID=
SUPABASE_S3_SECRET_ACCESS_KEY=
SUPABASE_S3_BUCKET=

# ---- AI chat (NVIDIA NIM) ----
NVIDIA_API_KEY=
AI_MODEL=
# Optional: only if you use a different OpenAI-compatible provider
AI_BASE_URL=
AI_API_KEY=

# ---- URLs ----
# Where the React app lives (eSewa sends people back here after payment)
FRONTEND_BASE_URL=http://localhost:5173
# Comma-separated list of frontend origins allowed to call this API
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
CSRF_TRUSTED_ORIGINS=

# Production only: set False only if your host does not terminate HTTPS
SECURE_SSL_REDIRECT=True